@{
    ViewData["Title"] = "Register";
}

<h2>Register</h2>

<form asp-controller="Account"
      asp-action="Register"
      method="post">

    <div>
        <label>Email</label>
        <input type="email"
               name="email"
               required />
    </div>

    <br />

    <div>
        <label>Password</label>
        <input type="password"
               name="password"
               required />
    </div>

    <br />

    <button type="submit">
        Register
    </button>

</form>

<p>
    Already have an account?
    <a asp-action="Login">Login</a>
</p>